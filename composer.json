{
    "name": "timbotron/initium-php-core",
    "description": "Core of InitiumPHP: a small, dependency-light PHP starter framework with turnkey user authentication.",
    "type": "library",
    "license": "MIT",
    "authors": [
        { "name": "Tim Habersack" }
    ],
    "require": {
        "php": ">=8.0",
        "nikic/fast-route": "^1.3",
        "league/plates": "^3.5",
        "catfan/medoo": "^2.1",
        "vlucas/valitron": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Initium\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
